farming:AddLabel("OP FARMING:")

local farmingConfigs = {
	{name = "Auto Pushups + Jungle rock", tool = "Pushups", rock = "Ancient Jungle Rock"},
	{name = "Auto Handstand + Jungle rock", tool = "Handstand", rock = "Ancient Jungle Rock"},
	{name = "Auto Situps + jungle rock", tool = "Situps", rock = "Ancient Jungle Rock"}
}

for _, config in ipairs(farmingConfigs) do
	-- Ginawang table para masigurong laging na-uupdate ang state bawat switch
	local switchState = { isActive = false }
	
	farming:AddSwitch(config.name, function(state)
		switchState.isActive = state
		
		if switchState.isActive then
			task.spawn(function()
				while switchState.isActive do
					local player = PlayerData.Player
					local char = player.Character
					local bp = player.Backpack
					
					if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
						-- Equip Main Tool kung wala pa sa kamay
						if not char:FindFirstChild(config.tool) and bp:FindFirstChild(config.tool) then
							char.Humanoid:EquipTool(bp[config.tool])
						end
						
						-- Fire muscle event para sa reps
						local muscleEvent = player:FindFirstChild("muscleEvent")
						if muscleEvent then
							muscleEvent:FireServer("rep")
						end
						
						-- Touch Rock
						local machinesFolder = Services.Workspace:FindFirstChild("machinesFolder")
						local rockObj = machinesFolder and machinesFolder:FindFirstChild(config.rock)
						local leftHand = char:FindFirstChild("LeftHand")
						
						if rockObj and rockObj:FindFirstChild("Rock") and leftHand then
							pcall(function()
								firetouchinterest(rockObj.Rock, leftHand, 0)
								firetouchinterest(rockObj.Rock, leftHand, 1)
							end)
						end
						
						-- Auto Punch
						if muscleEvent and (bp:FindFirstChild("Punch") or char:FindFirstChild("Punch")) then
							muscleEvent:FireServer("punch", "rightHand")
							muscleEvent:FireServer("punch", "leftHand")
						end
					end
					
					-- Delay para iwas anti-cheat / kick
					task.wait(0.05)
				end
			end)
		else
			-- Ibalik sa backpack ang tool kapag pinatay ang switch
			local char = PlayerData.Player.Character
			local toolObj = char and char:FindFirstChild(config.tool)
			if toolObj then
				toolObj.Parent = PlayerData.Player.Backpack
			end
		end
	end)
end
